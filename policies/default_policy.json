{
  "version": "1.0",
  "active_tier": "v3",
  "server_bindings": [
    {
      "server_id": "filesystem-local",
      "tool_capabilities": {
        "read_file": {
          "allowed_paths": ["/home/user/project/*", "/tmp/*"],
          "blocked_paths": ["/home/user/.ssh/*", "/etc/*", "**/.env"]
        }
      }
    },
    {
      "server_id": "network-egress",
      "tool_capabilities": {
        "http_request": {
          "allowed_domains": ["api.github.com", "pypi.org"],
          "blocked_domains": []
        }
      }
    }
  ],
  "approx_matching": {
    "ngram_size": 4,
    "coverage_threshold": 0.6,
    "sweep_thresholds": [0.4, 0.5, 0.6, 0.7, 0.8, 0.9]
  },
  "decode_limits": {
    "max_candidate_len_bytes": 8192,
    "max_candidates_per_payload": 256,
    "max_expansion_ratio": 4.0,
    "max_nesting_depth": 3
  },
  "cross_call_window": {
    "window_seconds": 300,
    "window_max_calls": 50
  },
  "enforcement": {
    "on_match": "ask_user",
    "approval_timeout_seconds": 60
  }
}
